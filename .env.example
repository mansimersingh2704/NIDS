# AI-NIDS Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/nids.db
SYNC_DATABASE_URL=sqlite:///./data/nids.db

# Packet Capture & Flow Engine
FLOW_ACTIVE_TIMEOUT_SEC=60.0
FLOW_IDLE_TIMEOUT_SEC=15.0
DEFAULT_CAPTURE_INTERFACE=
MAX_PCAP_FILE_SIZE_MB=50

# Detection & ML
ACTIVE_MODEL_NAME=xgboost
ANOMALY_DETECTION_ENABLED=true
ALERT_DEDUPLICATION_WINDOW_SEC=30.0
CRITICAL_ALERT_THRESHOLD=0.85
HIGH_ALERT_THRESHOLD=0.65
MEDIUM_ALERT_THRESHOLD=0.45

# Storage
DATA_DIR=./data
MODEL_DIR=./data/models
PCAP_STORAGE_DIR=./data/uploads
